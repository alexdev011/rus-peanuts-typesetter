# Кэш Python
__pycache__/
*.py[cod]
*$py.class

# Окружение
.venv/
env/
venv/
venv-legacy/
ENV/

# Сборка через PyInstaller
build/
dist/
*.spec

# Папка с результатами работы программы и временные списки
result/
validation list.txt

# Системные файлы и кэш редакторов
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
# Свои шрифты команды: у них разные лицензии, в репозиторий не кладём.
# Три основных шрифта программы уже в репозитории.
fonts/*
!fonts/Peanuts_by_me.ttf
!fonts/MPMangaFont-Bold.ttf
!fonts/Mp Manga Bold Shadow.ttf

# Тестовые образцы стрипов (защищены авторским правом, в репозиторий не попадают)
tests/fixtures/
.pytest_cache/
